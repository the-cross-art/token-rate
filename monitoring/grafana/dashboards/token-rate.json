    {
      "id": 14,
      "type": "stat",
      "title": "Gross margin vs hosted",
      "description": "How much of the hosted price you keep by serving it yourself. Goes negative when the machine idles between requests \u2014 amortization accrues whether or not you are generating tokens.",
      "datasource": {
        "type": "prometheus",
        "uid": "tokenrate-prom"
