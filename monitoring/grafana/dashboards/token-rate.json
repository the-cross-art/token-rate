    {
      "id": 9,
      "type": "timeseries",
      "title": "Local cost per 1k output tokens",
      "description": "Amortized hardware plus marginal electricity, divided by tokens produced. Unlike a hosted price list this is a function of TIME, not token count \u2014 so it falls as throughput rises. This panel is where speculative decoding turns into money. Cumulative, not a rate, for the same reason -- it stays correct between runs instead of decaying to No data.",
      "datasource": {
        "type": "prometheus",
        "uid": "tokenrate-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 15
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "tokenrate-prom"
          },
          "expr": "sum by (model) (tokenrate_local_cost_usd_total) * 1000\n  / (sum by (model) (tokenrate_completion_tokens_total) > 0)",
          "legendFormat": "{{model}}",
          "refId": "A",
          "editorMode": "code",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 5,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "pointSize": 8,
            "showPoints": "never",
            "spanNulls": true,
            "axisBorderShow": false,
            "gradientMode": "none",
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisSoftMax": 0.02
          },
          "min": 0
        },
        "overrides": [
