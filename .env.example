LLAMACPP_NGRAM_URL=http://127.0.0.1:8082
LLAMACPP_PLAIN_URL=http://127.0.0.1:8083
OLLAMA_BASE_URL=http://127.0.0.1:11434

# --- Proxy ---
PROXY_PORT=8080
LEDGER_DB=data/ledger.db

# --- Stripe (TEST MODE ONLY - key must start with sk_test_) ---
STRIPE_API_KEY=sk_test_xxx
STRIPE_METER_EVENT_NAME=llm_tokens
STRIPE_ENABLED=false
